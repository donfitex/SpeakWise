# Local development. Run python scripts/configure_local.py to generate private values.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=speakwise
POSTGRES_USER=speakwise
POSTGRES_PASSWORD=
# Leave blank for local Compose PostgreSQL. For Neon, set securely; see docs/neon.md.
DATABASE_URL=
DATABASE_HOST=localhost
REDIS_URL=redis://redis:6379/0
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional free offline ASR: pocketsphinx. It produces approximate text, not pronunciation scores.
SPEECH_PROVIDER=disabled
# Server policy never retains raw audio after processing; no replay-history opt-in yet.
# Public browser configuration only; never put a key in VITE_*.
VITE_API_BASE_URL=/api/v1
