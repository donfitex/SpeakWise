# Planned local-development configuration; application wiring follows in Phases 02–03.
# Copy to .env; never use these settings in production.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=speakwise
POSTGRES_USER=speakwise
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
SPEECH_PROVIDER=disabled
AUDIO_RETENTION_DAYS=0
# Public browser configuration only; no secrets belong in VITE_* variables.
VITE_API_BASE_URL=/api/v1
