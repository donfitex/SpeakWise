# Copy to .env.production. Never commit that file or actual values.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Neon connection string: use verify-full TLS; do not put it in frontend config.
DATABASE_URL=
DOMAIN=localhost
# For public TLS, set DOMAIN, DJANGO_ALLOWED_HOSTS, and CSRF_TRUSTED_ORIGINS to your hostname.
CSRF_TRUSTED_ORIGINS=https://localhost:8443
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
SPEECH_PROVIDER=disabled
# Configure a verified SMTP transport before supporting production password reset.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
